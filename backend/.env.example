# Copy to .env and adjust. .env is gitignored — never commit real credentials.

# Local Postgres (docker compose up -d postgres) — the default for development and tests.
DATABASE_URL=postgresql+psycopg://connectsphere:connectsphere@localhost:5432/connectsphere

# Shared Supabase database (Dashboard -> Connect -> Session pooler). Three things to get right:
#   1. the driver is "+psycopg", not the bare "postgresql://" Supabase shows you
#   2. the username is "postgres.<project-ref>", not just "postgres"
#   3. URL-encode special characters in the password (@ becomes %40, and so on)
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Frontend origins allowed to call this API. JSON list; defaults to the Vite dev server.
# CORS_ORIGINS=["http://localhost:5173"]

# Tests never use DATABASE_URL — they create their own connectsphere_test database and
# refuse to run against Supabase. Override only to point them at another local Postgres.
# TEST_DATABASE_URL=postgresql+psycopg://connectsphere:connectsphere@localhost:5432/connectsphere_test
